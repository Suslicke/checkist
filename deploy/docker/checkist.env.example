# Server environment for compose.prod.yaml.
# Copy to .env.prod in the repository root, mode 0600; never commit the copy.
# Format: NAME=value, no quotes, no spaces, no `export`. Values: letters, digits and _-./:,
# only - Compose would expand a `$` and strip quotes.
# Replace checkist.example with the real domain in the three lines that carry it.

# --- Compose only: Django does not read these. ---
# Site address of Caddy: the domain (automatic HTTPS certificate). `localhost` - a local check
# with an internal certificate.
CHECKIST_SITE_ADDRESS=checkist.example
# Published ports of the proxy; the only ports open to the outside. A local check binds
# loopback, for example 127.0.0.1:18080 and 127.0.0.1:18443.
# CHECKIST_HTTP_BIND=80
# CHECKIST_HTTPS_BIND=443
# Host directory of the backup copies, mounted as /backups; owner UID 10001, mode 0700.
# CHECKIST_BACKUP_DIR=/var/backups/checkist
# The recognition worker with Codex CLI or Claude Code CLI (RECEIPT_OCR_PROVIDER below). Uncomment
# only after the sign-in check of the chosen CLI succeeds:
#   deploy/docker/ck compose run --rm recognition codex login status
#   deploy/docker/ck compose run --rm recognition claude auth status
# COMPOSE_PROFILES=recognition
# The project name is `checkist` (compose.prod.yaml); it prefixes the volumes. Another name -
# another, empty set of volumes.
# COMPOSE_PROJECT_NAME=checkist

# --- Access and the site. ---
# Sign-in is required; `local_single` is refused together with DJANGO_DEBUG=0.
CHECKIST_AUTH_MODE=accounts
DJANGO_DEBUG=0
# Secrets are left empty on purpose: nothing starts until they are filled.
# Key and password: openssl rand -hex 32
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=checkist.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://checkist.example

# --- Behind the proxy. ---
# Caddy overwrites X-Forwarded-Proto / X-Forwarded-For; gunicorn is reachable only by the proxy.
DJANGO_TRUST_PROXY=1
DJANGO_SECURE_COOKIES=1
# Strict-Transport-Security max-age for Django and for Caddy; raise only after the server is accepted.
DJANGO_HSTS_SECONDS=3600

# --- PostgreSQL and Redis: services of the same Compose project, no published ports. ---
POSTGRES_DB=checkist
POSTGRES_USER=checkist
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
DJANGO_CACHE_URL=redis://redis:6379/2

# --- Automatic actions: off until the owner decides otherwise. ---
# The local-only API switch is for DEBUG dev/QA; on a server access comes from the account.
ALLOW_LOCAL_RECOGNITION_API=0
PRODUCT_MERGE_AUTO_DETECT=0
PRODUCT_CLASSIFICATION_AUTO_SUGGEST=0

# --- Files. Paths inside the containers; do not change without changing the volumes. ---
# Uploaded photos, volume `data` (mounted as /var/lib/checkist); served only by Django.
MEDIA_ROOT=/var/lib/checkist/media
# Private provider scratch, volume `ocr_scratch` of the recognition service; not part of backups.
RECEIPT_OCR_TEMP_ROOT=/var/lib/checkist-scratch

# --- Recognition. ---
# codex_cli - Codex CLI (sign-in in the volume codex_home); claude_cli - Claude Code CLI (token
# below). `fake` invents receipts: never on a server, only in a local check.
RECEIPT_OCR_PROVIDER=codex_cli
# Paths inside the recognition image; both CLIs are there, the provider picks one.
RECEIPT_OCR_CODEX_EXECUTABLE=/usr/local/bin/codex
RECEIPT_OCR_CLAUDE_EXECUTABLE=/usr/local/bin/claude
# Claude only: reasoning effort (low, medium, high) and the dollar budget of one call. With
# claude_cli the model defaults to claude-opus-5-5; RECEIPT_OCR_MODEL accepts opus, sonnet, haiku
# or a full claude-... name, with codex_cli it stays gpt-6.1-sol. The server admin's choice on /family
# («Модель ИИ», accounts.AiModelSetting) overrides RECEIPT_OCR_MODEL and the effort for claude_cli.
RECEIPT_OCR_CLAUDE_EFFORT=medium
RECEIPT_OCR_CLAUDE_MAX_BUDGET_USD=2.00
# Claude sign-in token: NOT here (this file reaches web and celery) - in .env.recognition next to
# this file, from deploy/docker/checkist.recognition.env.example; read by the recognition service only.

# --- Web push (уведомления). Empty — push is off and the app says so. ---
# Keys: `deploy/docker/ck manage push keys`; subject — mailto: or https: of the owner.
# Sending: cron `deploy/docker/ck manage push tick` every 5 minutes (docs/deployment-docker.md).
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=

# --- Planned spends: rates (% a year) of the deposit advice — fixed-term deposit, flexible deposit, investing. ---
PLANNED_RATE_FIXED=17
PLANNED_RATE_FLEXIBLE=15
PLANNED_RATE_INVEST=10

# --- Monitoring (docs/observability.md). Empty token — GET /metrics is a 404. ---
# Bearer token of Prometheus (`openssl rand -hex 32`); the same value goes to its scrape job.
METRICS_TOKEN=
# 1 — web joins the network checkist-metrics (Prometheus), postgres checkist-grafana-db (Grafana):
# compose.observability.yaml. Keep commented where these networks do not exist.
# CHECKIST_OBSERVABILITY=1

# --- Sign-in with Pocket ID (backend/accounts/pocket_id.py). Off unless all three are set: the routes answer 404 and
# the button is hidden. A confidential OIDC client with PKCE; its callback URL is exactly
# https://<CHECKIST_SITE_ADDRESS>/api/auth/pocket-id/callback/. People bind their Pocket ID on «Аккаунт» after a
# password sign-in; an unbound Pocket ID account is refused (no email matching, no new users).
# POCKET_ID_ISSUER=https://id.example.org
# POCKET_ID_CLIENT_ID=
# POCKET_ID_CLIENT_SECRET=
